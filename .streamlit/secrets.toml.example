# Copy this file to  .streamlit/secrets.toml  and fill in your Supabase values.
# secrets.toml is git-ignored — never commit real keys.

# Project URL and public anon key: Supabase dashboard → Project Settings → API
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "eyJ...your-anon-public-key..."

# Postgres connection string: Supabase → Connect → Session pooler → URI
# (host contains pooler.supabase.com; replace [YOUR-PASSWORD] with your DB password).
DATABASE_URL = "postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Directors: emails that get the director role. Everyone else who registers is a
# member. TOML array of strings. Kept here (git-ignored) so it isn't published.
DIRECTOR_EMAILS = ["director1@adrastea.org", "director2@adrastea.org"]
