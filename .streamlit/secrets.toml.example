# Copy this file to  .streamlit/secrets.toml  and fill in your Supabase values.
# secrets.toml is git-ignored — never commit real keys.

# Project URL and public anon key: Supabase dashboard → Project Settings → API
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "eyJ...your-anon-public-key..."

# Postgres connection string: Supabase → Project Settings → Database →
# "Connection string" → URI  (use the pooler URI; it includes your DB password).
DATABASE_URL = "postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
