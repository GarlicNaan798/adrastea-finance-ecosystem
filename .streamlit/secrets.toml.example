# Copy this file to  .streamlit/secrets.toml  and fill in your Supabase values.
# secrets.toml is git-ignored — never commit real keys.

# Project URL and public anon key: Supabase dashboard → Project Settings → API
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "eyJ...your-anon-public-key..."

# Postgres connection string: Supabase → Connect → Session pooler → URI
# (host contains pooler.supabase.com; replace [YOUR-PASSWORD] with your DB password).
DATABASE_URL = "postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Founders: global admins (assign track directors, manage any track/team/user).
FOUNDER_EMAILS = ["founder@adrastea.org"]

# Directors: track-scoped leaders. A founder assigns which track(s) each directs.
# Everyone else who registers is a member. TOML array of strings; git-ignored.
DIRECTOR_EMAILS = ["director1@adrastea.org", "director2@adrastea.org"]

# The app's public URL. Email-confirmation links redirect here after verifying.
# Use your Streamlit Cloud URL in production, http://localhost:8501 locally.
# Leave blank to fall back to Supabase's Site URL. Must be allow-listed under
# Supabase → Authentication → URL Configuration → Redirect URLs.
APP_URL = "https://your-app.streamlit.app"
